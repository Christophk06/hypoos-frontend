{
  "name": "ouverture-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native App-Hülle (Capacitor) für Ouverture – lädt die Live-PWA",
  "engines": { "node": ">=22" },
  "scripts": {
    "assets": "capacitor-assets generate --iconBackgroundColor '#1C2430' --splashBackgroundColor '#F6F4EF'",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
